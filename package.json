{
  "name": "image-upscale",
  "productName": "ImageUpscale",
  "version": "1.0.0",
  "description": "On-device image upscaler. Nothing leaves your machine.",
  "author": "Sam Reisen",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "icons": "node scripts/make-icons.js",
    "models": "node scripts/fetch-models.js",
    "dist:win": "electron-builder --win --x64 --arm64 --publish never",
    "dist:mac": "electron-builder --mac --universal -c.mac.identity=- --publish never",
    "bench": "node scripts/bench.js",
    "mark": "node scripts/make-mark.js",
    "verify:marks": "node scripts/verify-mark-system.js",
    "predist:win": "node scripts/cross-deps.js win && node scripts/fetch-models.js fast",
    "predist:mac": "node scripts/cross-deps.js mac && node scripts/fetch-models.js fast",
    "deps:cross": "node scripts/cross-deps.js all",
    "predist:dir": "node scripts/fetch-models.js fast",
    "dist:dir": "electron-builder --linux dir --x64 --publish never",
    "dist:win:portable": "electron-builder --win portable --x64 --arm64 --publish never -c.win.signAndEditExecutable=false -c.win.target=portable",
    "predist:win:portable": "node scripts/cross-deps.js win && node scripts/fetch-models.js fast",
    "logo": "node scripts/make-logo.js"
  },
  "build": {
    "appId": "com.samuelreisen.imageupscale",
    "productName": "ImageUpscale",
    "copyright": "Copyright (c) 2026 Sam Reisen",
    "asar": true,
    "asarUnpack": [
      "node_modules/onnxruntime-node/**/*",
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "scripts/markpack.js",
      "scripts/install-mark.js",
      "scripts/mark.config.json",
      "build/icon.png",
      "HANDOFF.md",
      "mark.json",
      "package.json",
      "!node_modules/adm-zip/**",
      "!node_modules/global-agent/**",
      "!node_modules/roarr/**",
      "!node_modules/sprintf-js/**",
      "!node_modules/onnxruntime-node/script/**"
    ],
    "extraResources": [
      {
        "from": "models/fast.onnx",
        "to": "models/fast.onnx"
      }
    ],
    "fileAssociations": [
      {
        "ext": "upscl",
        "name": "ImageUpscale update file",
        "role": "Editor"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ImageUpscale",
      "buildUniversalInstaller": false,
      "artifactName": "ImageUpscale-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "ImageUpscale-Portable-${version}-${arch}.${ext}"
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.graphics-design",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "ImageUpscale-${version}-universal.${ext}"
    },
    "afterPack": "scripts/after-pack.js",
    "electronLanguages": [
      "en-US"
    ],
    "linux": {
      "icon": "build/icon.png",
      "category": "Graphics",
      "target": [
        "dir"
      ]
    }
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "png2icons": "^2.0.1"
  },
  "dependencies": {
    "onnxruntime-node": "1.23.2",
    "sharp": "^0.35.5"
  }
}
